modules = ["python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["SDL2", "SDL2_image", "SDL2_mixer", "SDL2_ttf", "fontconfig", "freetype", "libjpeg", "libpng", "pkg-config", "portmidi"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Lunar Rover Game"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pygame_rover_game"

[[workflows.workflow]]
name = "Lunar Rover Game"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install pygame numpy && python main.py"

[[workflows.workflow]]
name = "pygame_rover_game"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/work && pip install pygame numpy && python main.py"
